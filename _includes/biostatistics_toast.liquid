    <text x="12" y="23" fill="#553173" font-size="20" font-weight="700" font-family="Arial, sans-serif">Ridge</text>
    <g fill="none" stroke-width="2.2">
      <path d="M15 82 H119 M50 94 V32" stroke="#aaa"/>
      <circle cx="49" cy="68" r="18" stroke="#88ca8b"/><circle cx="49" cy="68" r="29" stroke="#88ca8b"/>
      <ellipse cx="99" cy="46" rx="48" ry="26" stroke="#c791a1"/><ellipse cx="99" cy="46" rx="32" ry="17" stroke="#c791a1"/>
    </g><circle cx="72" cy="49" r="4" fill="#3968bd"/>
    <text x="10" y="109" fill="#322b39" font-size="15" font-family="Arial, sans-serif">min ‖y−Xβ‖² + λ‖β‖₂²</text>
  </g></g>
  <g transform="translate(380 287)"><g class="toast-float toast-lasso">
    <rect width="198" height="119" rx="11" fill="#fff" fill-opacity=".95" stroke="#ac8abf" stroke-width="2"/>
    <text x="12" y="23" fill="#553173" font-size="20" font-weight="700" font-family="Arial, sans-serif">LASSO</text>
    <g fill="none" stroke-width="2.2">
      <path d="M15 82 H119 M50 94 V32" stroke="#aaa"/>
      <path d="M50 38 L87 65 L50 92 L13 65 Z M50 49 L72 65 L50 81 L28 65 Z" stroke="#88ca8b"/>
      <ellipse cx="100" cy="46" rx="47" ry="26" stroke="#c791a1"/><ellipse cx="100" cy="46" rx="31" ry="17" stroke="#c791a1"/>
    </g><circle cx="50" cy="37" r="4" fill="#3968bd"/>
    <text x="10" y="109" fill="#322b39" font-size="15" font-family="Arial, sans-serif">min ‖y−Xβ‖² + λ‖β‖₁</text>
  </g></g>
  <g transform="translate(474 439)"><g class="toast-float toast-dna">
    <circle cx="24" cy="24" r="23" fill="#fff" fill-opacity=".94" stroke="#8c6aac" stroke-width="2"/>
