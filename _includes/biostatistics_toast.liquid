    <clipPath id="toast-arm-clip"><use href="#toast-arm-shape"/></clipPath>
    <mask id="toast-body-mask" maskUnits="userSpaceOnUse" x="0" y="0" width="800" height="566">
      <rect width="800" height="566" fill="white"/><use href="#toast-arm-shape" fill="black"/>
    </mask>
    <path id="toast-cap-shape" d="M611 63 Q655 52 698 61 L703 66 L704 92 Q689 97 671 102 L638 108 L615 111 L609 102 L607 75 Q606 67 611 63 Z"/>
