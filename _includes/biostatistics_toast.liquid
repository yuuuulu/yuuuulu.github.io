    <image href="{{ '/assets/img/prof_pic.webp' | relative_url }}" width="800" height="566" clip-path="url(#toast-arm-clip)" mask="url(#toast-cap-mask)"/>
    <g class="toast-cdf">
      <path d="M591 263 L763 252 L775 365 L596 382 Z" fill="#fffafc" stroke="#362341" stroke-width="2"/>
