      <image href="{{ '/assets/img/prof_pic.webp' | relative_url }}" width="800" height="566" clip-path="url(#toast-cap-clip)"/>
    </g>
  </g>
  <g transform="translate(373 134)"><g class="toast-float toast-ridge">
