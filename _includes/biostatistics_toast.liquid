<style>
.biostat-toast { display:block; width:100%; max-width:420px; overflow:visible; }
.biostat-toast svg { display:block; width:100%; height:auto; overflow:visible; }
.biostat-toast .toast-arm { transform-box:view-box; transform-origin:435px 535px; animation:toast-raise 9s ease-in-out 1s infinite; }
.biostat-toast .toast-cap { transform-box:view-box; transform-origin:658px 93px; animation:toast-open 9s ease-in-out 1s infinite; }
.biostat-toast .toast-cdf { opacity:0; animation:toast-label 9s linear 1s infinite; }
.biostat-toast .toast-steps { stroke-dasharray:270; stroke-dashoffset:270; animation:toast-draw 9s ease-in-out 1s infinite; }
.biostat-toast .toast-float { opacity:0; animation:toast-float 9s ease-in-out 1s infinite; }
.biostat-toast .toast-lasso { animation-delay:.45s; }
.biostat-toast .toast-dna { animation-delay:-.1s; }
.biostat-toast .toast-clinical { animation-delay:-.55s; }
@keyframes toast-open {
  0%,100% { transform:translate(0,0) rotate(0); }
  30%,60% { transform:translate(-20px,-62px) rotate(-14deg); }
  73% { transform:translate(-32px,-85px) rotate(-20deg); }
  87% { transform:translate(-15px,-43px) rotate(-6deg); }
}
@keyframes toast-raise {
  0%,24%,100% { transform:rotate(0); }
  43%,72% { transform:rotate(-5deg); }
  87% { transform:rotate(-2deg); }
}
@keyframes toast-label {
  0%,32%,89%,100% { opacity:0; }
  42%,80% { opacity:1; }
}
@keyframes toast-draw {
  0%,36% { stroke-dashoffset:270; }
  64%,83% { stroke-dashoffset:0; }
  100% { stroke-dashoffset:270; }
}
@keyframes toast-float {
  0%,29% { opacity:0; transform:translateY(23px); }
  39% { opacity:.98; }
  75% { opacity:.98; transform:translateY(-33px); }
  92%,100% { opacity:0; transform:translateY(-72px); }
}
@media (prefers-reduced-motion:reduce) {
  .biostat-toast .toast-arm,.biostat-toast .toast-cap,.biostat-toast .toast-cdf,.biostat-toast .toast-steps,.biostat-toast .toast-float { animation:none!important; }
  .biostat-toast .toast-cdf,.biostat-toast .toast-float { opacity:0; }
}
</style>
<div class="biostat-toast">
<svg viewBox="0 0 800 566" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="toast-title toast-desc">
  <title id="toast-title">A biostatistics toast</title>
